func build_shuffled_deck():
	var deck: Array = []
	for card_key in CARDS.keys():
		var data = CARDS[card_key]
		if data["type"] == "entity":
			deck.append(card_key)
		elif data["type"] == "skill":
			for i in range(3):
				deck.append(card_key)
	deck.shuffle()
	return deck


func get_total_deck_size():
	var total := 0
	for card_key in CARDS.keys():
		var data = CARDS[card_key]
		if data["type"] == "entity":
			total += 1
		elif data["type"] == "skill":
			total += 3
	return total
