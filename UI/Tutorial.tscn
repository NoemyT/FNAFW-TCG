[node name="Title" type="Label" parent="TabContainer/About 1" unique_id=812253126]
layout_mode = 0
offset_left = 1.0
offset_top = 13.0
offset_right = 856.0
offset_bottom = 151.0
theme_override_colors/font_outline_color = Color(0.76862746, 0, 0, 1)
theme_override_constants/outline_size = 16
theme_override_fonts/font = ExtResource("2_qouqw")
